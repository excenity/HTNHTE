library(data.table)
tmle_results_df1 = fread('/Users/excenity/Documents/HSIP/Research/Dissertation Project/Results/results_072225/tmle_results_df/at_control_13080.csv')
tmle_results_df2 = fread('/Users/excenity/Documents/HSIP/Research/Dissertation Project/Results/results_072225/tmle_results_df/at_control_14090.csv')
tmle_results_df3 = fread('/Users/excenity/Documents/HSIP/Research/Dissertation Project/Results/results_072225/tmle_results_df/sbp_change.csv')
tmle_neg_results_df = fread('/Users/excenity/Documents/HSIP/Research/Dissertation Project/Results/results_072225/tmle_results_df/sbp_change_bmi_neg.csv')
tmle_neg_results_df = tmle_neg_results_df %>% filter(htn_med_class!= 'bb')
cleanup_df = function(tmle_results_df, percentage = T, max_diff = T){
# relevel htn med class factor
tmle_results_df$htn_med_class = toupper(as.character(tmle_results_df$htn_med_class))
tmle_results_df$htn_med_class[tmle_results_df$htn_med_class == 'ACEI'] = 'ACEi'
tmle_results_df$htn_med_class[tmle_results_df$htn_med_class == 'DIURETIC'] = 'Diuretics'
tmle_results_df$htn_med_class[tmle_results_df$htn_med_class == 'DIURETIC_COMBO'] = 'Diuretics Combo'
tmle_results_df$htn_med_class[tmle_results_df$htn_med_class == 'CCB_COMBO'] = 'CCB Combo'
tmle_results_df$htn_med_class = factor(tmle_results_df$htn_med_class, levels = c('ACEi', 'ARB', 'CCB', 'Diuretics', 'CCB Combo', 'Diuretics Combo'))
# update labels
tmle_results_df$sbp = 'SBP<150mmHg'
tmle_results_df$sbp[grep('150,300', tmle_results_df$patient_profiles)] = 'SBP≥150mmHg'
tmle_results_df$bmi = 'BMI<30'
tmle_results_df$bmi[grep('30,100', tmle_results_df$patient_profiles)] = 'BMI≥30'
tmle_results_df$age = '≥65 Y/O'
tmle_results_df$age[grep('0,65', tmle_results_df$patient_profiles)] = '<65 Y/O'
tmle_results_df$pp_label = paste(tmle_results_df$sbp, '/', tmle_results_df$bmi, '/', tmle_results_df$age)
pp_list = tmle_results_df %>% arrange(pp_label) %>% distinct(pp_label)
pp_list$number = 1:nrow(pp_list)
num_alphabet_df = data.frame('number' = c(1, 2, 3, 4, 5, 6, 7, 8),
'alphabet' = c('a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'))
pp_list = left_join(pp_list, num_alphabet_df)
tmle_results_df = left_join(tmle_results_df, pp_list)
tmle_results_df$pp_label = paste0(tmle_results_df$alphabet, ') ', tmle_results_df$pp_label)
if (percentage == T)
{
tmle_results_df$Q1_star_avg = tmle_results_df$Q1_star_avg * 100
tmle_results_df$Q1_star_ub = tmle_results_df$Q1_star_ub * 100
tmle_results_df$Q1_star_lb = tmle_results_df$Q1_star_lb * 100
}
if (max_diff == T)
{
tmle_results_df = tmle_results_df %>% group_by(patient_profiles) %>% arrange(Q1_star_avg) %>% mutate(ranking = row_number())
tmle_results_max = tmle_results_df %>% filter(ranking == 1) %>% select(Q1_star_avg, patient_profiles) %>% rename('Q1_star_max' = 'Q1_star_avg')
tmle_results_min = tmle_results_df %>% filter(ranking == 6) %>% select(Q1_star_avg, patient_profiles) %>% rename('Q1_star_min' = 'Q1_star_avg')
tmle_results_minmax = inner_join(tmle_results_max, tmle_results_min)
tmle_results_minmax$diff = as.character(abs(round(tmle_results_minmax$Q1_star_max - tmle_results_minmax$Q1_star_min,1)))
tmle_results_df = left_join(tmle_results_df, tmle_results_minmax %>% select(patient_profiles, diff))
}
return(tmle_results_df)
}
tmle_results_df1 = cleanup_df(tmle_results_df1)
tmle_results_df2 = cleanup_df(tmle_results_df2)
tmle_results_df3 = cleanup_df(tmle_results_df3, percentage = F)
tmle_neg_results_df = cleanup_df(tmle_neg_results_df, percentage = F, max_diff = F)
tmle_results_df1$diff = paste0('Max Difference in Predicted Treatment Effect: ', tmle_results_df1$diff, '%')
TMLE_plot1 = ggplot2::ggplot(tmle_results_df1, ggplot2::aes(x = htn_med_class, y = Q1_star_avg, color = htn_med_class)) +
ggplot2::geom_point() +
ggplot2::geom_linerange(ggplot2::aes(ymin=Q1_star_lb, ymax=Q1_star_ub)) +
ggplot2::geom_text(aes(x = 3.5, y = -35, label = diff), color = 'gray26') +
ggplot2::facet_wrap('pp_label', nrow = 2) +
ggplot2::theme_bw() +
ggplot2::theme(axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1), text=element_text(size=16), legend.position = 'bottom', legend.title = element_blank()) +
ggplot2::xlab('Antihypertensive Medication Class') +
ggplot2::ylab('Predicted Percentage of Individuals with Blood Pressure at 140/90 mm Hg (%)') +
ggplot2::scale_color_brewer(palette = 'Dark2')
TMLE_plot1
ggsave('/Users/excenity/Documents/HSIP/Research/Dissertation Project/Results/results_030725/tmle_plots_final/HTNHTE_14090.png', TMLE_plot1)
tmle_results_df2$diff = paste0('Max Difference in Predicted Treatment Effect: ', tmle_results_df2$diff, '%')
TMLE_plot2 = ggplot2::ggplot(tmle_results_df2, ggplot2::aes(x = htn_med_class, y = Q1_star_avg, color = htn_med_class)) +
ggplot2::geom_point() +
ggplot2::geom_linerange(ggplot2::aes(ymin=Q1_star_lb, ymax=Q1_star_ub)) +
ggplot2::geom_text(aes(x = 3.5, y = -35, label = diff), color = 'gray26') +
ggplot2::facet_wrap('pp_label', nrow = 2) +
ggplot2::theme_bw() +
ggplot2::theme(axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1), text=element_text(size=16), legend.position = 'bottom', legend.title = element_blank()) +
ggplot2::xlab('Antihypertensive Medication Class') +
ggplot2::ylab('Predicted Percentage of Individuals with Blood Pressure at 130/80 mm Hg (%)') +
ggplot2::scale_color_brewer(palette = 'Dark2')
TMLE_plot2
ggsave('/Users/excenity/Documents/HSIP/Research/Dissertation Project/Results/results_030725/tmle_plots_final/HTNHTE_13080.png', TMLE_plot2)
