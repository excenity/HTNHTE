tmle_results_df$sbp[grep('0,30', tmle_results_df$patient_profiles)] = 'Normal Weight'
tmle_results_df$sbp = 'High SBP'
tmle_results_df$sbp[grep('150,300', tmle_results_df$patient_profiles)] = 'Very High SBP'
tmle_results_df$bmi = 'Obese'
tmle_results_df$sbp[grep('0,30', tmle_results_df$patient_profiles)] = 'Normal Weight'
tmle_results_df$age = '65+ Y/O'
tmle_results_df$sbp[grep('0,65', tmle_results_df$patient_profiles)] = '<65 Y/O'
tmle_results_df$pp_label = paste(tmle_results_df$sbp, '/', tmle_results_df$bmi, '/', tmle_results_df$age)
TMLE_plot = ggplot2::ggplot(tmle_results_df, ggplot2::aes(x = htn_med_class, y = Q1_star_avg, color = htn_med_class)) +
ggplot2::geom_point() +
ggplot2::geom_linerange(ggplot2::aes(ymin=Q1_star_lb, ymax=Q1_star_ub)) +
ggplot2::facet_wrap('pp_label', nrow = 2) +
ggplot2::theme_bw() +
ggplot2::theme(axis.text.x = element_text(angle = 45, hjust = 0.5, vjust = 1), text=element_text(size=14)) +
ggplot2::xlab('Hypertension Medication Class') +
ggplot2::ylab('Predicted Treatment Effect')
TMLE_plot
